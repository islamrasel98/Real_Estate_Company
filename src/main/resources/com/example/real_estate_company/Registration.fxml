<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>


<AnchorPane prefHeight="600.0" prefWidth="554.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.RegistrationController">
   <children>
      <Label layoutY="-1.0" prefHeight="54.0" prefWidth="600.0" style="-fx-background-color: #C5ECD6;" text="                                   Customer Registration">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <Label layoutX="29.0" layoutY="88.0" text="Customer ID:">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <Label layoutX="34.0" layoutY="138.0" text="Full Name :">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <Label layoutX="29.0" layoutY="197.0" text="Email :">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <Label layoutX="24.0" layoutY="254.0" text="Phone Number :">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <Label layoutX="24.0" layoutY="323.0" text="Password:">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <Label layoutX="29.0" layoutY="393.0" text="Confirm Password:">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <Button layoutX="453.0" layoutY="437.0" mnemonicParsing="false" onAction="#registerButtonOnAction" prefHeight="38.0" prefWidth="82.0" style="-fx-background-color: #93E3EC;" text="Register">
         <font>
            <Font size="14.0" />
         </font>
      </Button>
      <Button layoutX="196.0" layoutY="513.0" mnemonicParsing="false" onAction="#backToLoginButtonOnAction" text="Back to Login">
         <font>
            <Font size="14.0" />
         </font>
      </Button>
      <Label layoutX="32.0" layoutY="516.0" text="Already have an account?">
         <font>
            <Font size="14.0" />
         </font>
      </Label>
      <TextField fx:id="customerIdTextField" layoutX="156.0" layoutY="85.0" prefHeight="26.0" prefWidth="378.0" />
      <TextField fx:id="nameTextField" layoutX="156.0" layoutY="135.0" prefHeight="26.0" prefWidth="378.0" />
      <TextField fx:id="emailTextField" layoutX="156.0" layoutY="194.0" prefHeight="26.0" prefWidth="378.0" />
      <TextField fx:id="phoneTextField" layoutX="156.0" layoutY="251.0" prefHeight="26.0" prefWidth="378.0" />
      <TextField fx:id="passwordField" layoutX="156.0" layoutY="320.0" prefHeight="26.0" prefWidth="378.0" />
      <TextField fx:id="confirmPasswordField" layoutX="156.0" layoutY="390.0" prefHeight="26.0" prefWidth="378.0" />
   </children>
